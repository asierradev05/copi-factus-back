# Copigrafica Sierra - Backend API
# Copiar a .env y completar valores. NUNCA commitear .env

# PostgreSQL connection (Supabase o local)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=no-verify"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=no-verify"

# Server
NODE_ENV=production
PORT=3001
CORS_ORIGIN="https://copifactus-front.onrender.com,http://localhost:5173,http://localhost:5174,http://localhost:5175"

# Supabase
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SECRET_KEY="[SUPABASE_SECRET_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"
SUPABASE_JWKS_URL="https://[PROJECT_REF].supabase.co/auth/v1/.well-known/jwks.json"

# JWT - OBLIGATORIO: secreto fuerte (>= 16 chars). El app falla al arrancar si es débil.
JWT_SECRET="cambia-este-secreto-por-uno-aleatorio-fuerte"
JWT_EXPIRES_IN="8h"

# URL pública del frontend (usada en correos)
FRONTEND_URL="https://copifactus-front.onrender.com"

# Contraseña usada al hacer seed/backfill de hashes de usuarios
DEV_PASSWORD="CambiaEstaPassword"
