# Copigrafica Sierra - Backend API
# Copiar a .env y completar valores. NUNCA commitear .env

# PostgreSQL connection (Supabase)
# DATABASE_URL = TRANSACTION POOLER (serverless/Vercel): puerto 6543, host *.pooler.supabase.com
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=no-verify"
# DIRECT_URL = CONEXIÓN DIRECTA (prisma db push / scripts / ts-node): puerto 5432, host db.[PROJECT_REF].supabase.co
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=no-verify"

# Server
NODE_ENV=production
PORT=3001
CORS_ORIGIN="https://copifactus-front.onrender.com,http://localhost:5173,http://localhost:5174,http://localhost:5175"

# Supabase
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SECRET_KEY="[SUPABASE_SECRET_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"
SUPABASE_JWKS_URL="https://[PROJECT_REF].supabase.co/auth/v1/.well-known/jwks.json"

# JWT - OBLIGATORIO: secreto fuerte (>= 16 chars). El app falla al arrancar si es débil.
JWT_SECRET="cambia-este-secreto-por-uno-aleatorio-fuerte"
JWT_EXPIRES_IN="8h"

# URL pública del frontend (usada en correos)
FRONTEND_URL="https://copifactus-front.onrender.com"

# --- Correo (Resend, opcional) ---
# Si RESEND_API_KEY está presente, los correos se envían vía Resend.
# EMAIL_FROM debe ser un dominio verificado en Resend (default: facturacion@copigraficassierra.com).
RESEND_API_KEY="[RESEND_API_KEY]"
EMAIL_FROM="facturacion@copigraficassierra.com"

# Contraseña usada al hacer seed/backfill de hashes de usuarios
DEV_PASSWORD="CambiaEstaPassword"

# --- Facturación electrónica DIAN (Factus) ---
# Ambiente sin credenciales: sandbox. Producción: habilitado.
FACTUS_AMBIENT="sandbox"
FACTUS_SEND_EMAIL="false"
FACTUS_URL="https://api-sandbox.factus.com.co"
FACTUS_CLIENT_ID="[FACTUS_CLIENT_ID]"
FACTUS_CLIENT_SECRET="[FACTUS_CLIENT_SECRET]"
FACTUS_USERNAME="[FACTUS_USERNAME]"
FACTUS_PASSWORD="[FACTUS_PASSWORD]"
