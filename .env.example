# Copigrafica Sierra - Backend API
# Copy this file to .env and fill in your values

# PostgreSQL connection (Supabase or local)
# Use the direct connection string from your Supabase project.
DATABASE_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# Server
PORT=3001
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000"

# Supabase
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SECRET_KEY="[YOUR_SUPABASE_SECRET_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR_SERVICE_ROLE_KEY]"
SUPABASE_JWT_SECRET="[YOUR_SUPABASE_JWT_SECRET]"

# JWT (development)
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"

# Development auth (login endpoint POST /api/auth/login)
DEV_PASSWORD="Admin123!"

# Optional: per-user dev passwords as JSON map
# DEV_USERS='{"admin@copigrafica.dev":"Admin123!","facturador@copigrafica.dev":"Fact123!"}'

# Email (facturas por correo - POST /invoices/:id/send-email)
# Si SMTP_HOST queda vacío, el correo se simula en consola (modo dev).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE="false"
# SMTP_USER="tu-correo@gmail.com"
# SMTP_PASS="tu-contrasena-aplicacion"
# SMTP_FROM="Copigrafica Sierra <tu-correo@gmail.com>"

# URL pública del frontend usada en los correos
FRONTEND_URL="http://localhost:5175"
