generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  FACTURADOR
  CONSULTA
}

enum DocumentType {
  CC
  NIT
  CE
  PASAPORTE
  OTRO
}

enum ServiceStatus {
  SOLICITADO
  EN_PROCESO
  TERMINADO
  ENTREGADO
  FACTURADO
  CANCELADO
}

enum InvoiceStatus {
  BORRADOR
  EMITIDA
  PARCIALMENTE_PAGADA
  PAGADA
  VENCIDA
  CANCELADA
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  OTRO
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  EMIT
  CANCEL
  PAYMENT
  LOGIN
}

enum RecurringServiceStatus {
  ACTIVO
  PAGADO
  CANCELADO
}

enum DianStatus {
  NO_APLICA
  PENDIENTE
  ENVIADA
  VALIDADA
  RECHAZADA
}

enum QuoteStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
  FACTURADA
}

enum PurchaseOrderStatus {
  SOLICITADA
  APROBADA
  RECIBIDA
  CANCELADA
}

enum DeliveryOrderStatus {
  PENDIENTE
  ENTREGADA
  CANCELADA
}

enum ResolutionType {
  FACTURA
  NOTA_CREDITO
  OTRO
}

enum Ambient {
  HABILITACION
  PRODUCCION
}

model Profile {
  id        String   @id @default(uuid())
  authId       String?  @unique @map("auth_id")
  email        String   @unique
  fullName     String   @map("full_name")
  role         UserRole @default(FACTURADOR)
  isActive     Boolean  @default(true) @map("is_active")
  passwordHash String?  @map("password_hash")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  servicesCreated  Service[]  @relation("ServiceCreator")
  invoicesCreated  Invoice[]  @relation("InvoiceCreator")
  paymentsCreated  Payment[]  @relation("PaymentCreator")
  auditLogs        AuditLog[]
  recurringServicesCreated RecurringService[] @relation("RecurringServiceCreator")
  invoiceUploads        InvoiceUpload[]      @relation("InvoiceUploader")
  quotesCreated         Quote[]              @relation("QuoteCreator")
  purchaseOrdersCreated PurchaseOrder[]      @relation("PurchaseOrderCreator")
  deliveryOrdersCreated DeliveryOrder[]      @relation("DeliveryOrderCreator")
  receivedDocumentsCreated ReceivedDocument[] @relation("ReceivedDocumentCreator")
  publicInquiriesHandled PublicInquiry[] @relation("PublicInquiryHandler")
  attachmentsUploaded DocumentAttachment[] @relation("AttachmentUploader")

  @@map("profiles")
}

model Customer {
  id             String       @id @default(uuid())
  name           String
  documentType   DocumentType @default(CC) @map("document_type")
  documentNumber String?      @map("document_number")
  phone          String
  email          String?
  address        String?
  city           String?
  notes          String?
  isActive       Boolean      @default(true) @map("is_active")
  deletedAt      DateTime?    @map("deleted_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  services         Service[]
  invoices         Invoice[]
  payments         Payment[]
  quotes           Quote[]
  purchaseOrders   PurchaseOrder[]
  deliveryOrders   DeliveryOrder[]
  receivedDocuments ReceivedDocument[]
  invoiceUploads   InvoiceUpload[]

  @@index([phone])
  @@map("customers")
}

model ServiceType {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  services Service[]

  @@map("service_types")
}

model Service {
  id            String        @id @default(uuid())
  customerId    String        @map("customer_id")
  serviceTypeId String        @map("service_type_id")
  description   String
  quantity      Decimal       @db.Decimal(12, 2)
  unitPrice     Decimal       @map("unit_price") @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  taxRate       Decimal       @default(0) @map("tax_rate") @db.Decimal(5, 2)
  subtotal      Decimal       @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  requestedAt   DateTime      @map("requested_at")
  deliveryDate  DateTime?     @map("delivery_date")
  status        ServiceStatus @default(SOLICITADO)
  assignedTo    String?       @map("assigned_to")
  notes         String?
  createdById   String?       @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  customer    Customer             @relation(fields: [customerId], references: [id])
  serviceType ServiceType          @relation(fields: [serviceTypeId], references: [id])
  createdBy   Profile?             @relation("ServiceCreator", fields: [createdById], references: [id])
  invoiceLink ServiceInvoiceLink?

  @@index([customerId])
  @@index([status])
  @@map("services")
}

model Product {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  description String?
  unitPrice   Decimal   @map("unit_price") @db.Decimal(12, 2)
  taxRate     Decimal   @default(0) @map("tax_rate") @db.Decimal(5, 2)
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  invoiceItems InvoiceItem[]

  @@map("products")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String?       @unique @map("invoice_number")
  customerId    String        @map("customer_id")
  issueDate     DateTime?     @map("issue_date")
  dueDate       DateTime?     @map("due_date")
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  discountTotal Decimal       @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal      Decimal       @default(0) @map("tax_total") @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  balance       Decimal       @default(0) @db.Decimal(12, 2)
  status        InvoiceStatus @default(BORRADOR)
  notes         String?
  cancelledAt   DateTime?     @map("cancelled_at")
  cufe          String?       @map("cufe")
  resolutionNumber  String?   @map("resolution_number")
  resolutionDate    DateTime? @map("resolution_date")
  dianStatus    DianStatus    @default(NO_APLICA) @map("dian_status")
  resolutionId  String?       @map("resolution_id")
  isValid       Boolean       @default(true) @map("is_valid")
  ambient       Ambient       @default(PRODUCCION) @map("ambient")
  responseDian  Json?         @map("response_dian")
  emailSentAt   DateTime?     @map("email_sent_at")
  createdById   String?       @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  customer     Customer             @relation(fields: [customerId], references: [id])
  createdBy    Profile?             @relation("InvoiceCreator", fields: [createdById], references: [id])
  resolution   Resolution?          @relation(fields: [resolutionId], references: [id])
  items        InvoiceItem[]
  serviceLinks ServiceInvoiceLink[]
  payments     Payment[]
  purchaseOrders PurchaseOrder[]
  deliveryOrders DeliveryOrder[]

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String   @map("invoice_id")
  productId   String?  @map("product_id")
  description String
  quantity    Decimal  @db.Decimal(12, 2)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  taxRate     Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  subtotal    Decimal  @db.Decimal(12, 2)
  taxAmount   Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@map("invoice_items")
}

model ServiceInvoiceLink {
  id        String   @id @default(uuid())
  serviceId String   @unique @map("service_id")
  invoiceId String   @map("invoice_id")
  createdAt DateTime @default(now()) @map("created_at")

  service Service @relation(fields: [serviceId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("service_invoice_links")
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String        @map("invoice_id")
  customerId    String        @map("customer_id")
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @map("payment_method")
  paymentDate   DateTime      @map("payment_date")
  reference     String?
  notes         String?
  createdById   String?       @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at")

  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy Profile? @relation("PaymentCreator", fields: [createdById], references: [id])

  @@index([invoiceId])
  @@index([customerId])
  @@map("payments")
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?     @map("user_id")
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  oldValue   Json?       @map("old_value")
  newValue   Json?       @map("new_value")
  createdAt  DateTime    @default(now()) @map("created_at")

  user Profile? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model CompanySettings {
  id                 String   @id @default("default")
  name               String
  legalName          String   @map("legal_name")
  taxId              String?  @map("tax_id")
  logoUrl            String?  @map("logo_url")
  address            String?
  phone              String?
  email              String?
  city               String?
  invoicePrefix      String   @default("FAC") @map("invoice_prefix")
  invoiceNextNumber  Int      @default(1) @map("invoice_next_number")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

model ServiceCategory {
  id           String               @id @default(uuid())
  name         String               @unique
  description  String?
  isActive     Boolean              @default(true) @map("is_active")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  subcategories ServiceSubcategory[]
  services      RecurringService[]

  @@map("service_categories")
}

model ServiceSubcategory {
  id          String              @id @default(uuid())
  categoryId  String              @map("category_id")
  name        String
  description String?
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  category ServiceCategory   @relation(fields: [categoryId], references: [id])
  services RecurringService[]

  @@unique([categoryId, name])
  @@map("service_subcategories")
}

model RecurringService {
  id            String                @id @default(uuid())
  categoryId    String                @map("category_id")
  subcategoryId String                @map("subcategory_id")
  name          String
  provider      String?
  description   String?
  amount        Decimal               @default(0) @db.Decimal(12, 2)
  billingDay    Int?                  @map("billing_day")
  status        RecurringServiceStatus @default(ACTIVO)
  dueDate       DateTime?             @map("due_date")
  lastPaidAt    DateTime?             @map("last_paid_at")
  notes         String?
  createdById   String?               @map("created_by")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  category    ServiceCategory    @relation(fields: [categoryId], references: [id])
  subcategory ServiceSubcategory @relation(fields: [subcategoryId], references: [id])
  createdBy   Profile?           @relation("RecurringServiceCreator", fields: [createdById], references: [id])

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([status])
  @@map("recurring_services")
}

model InvoiceUpload {
  id               String     @id @default(uuid())
  fileName         String     @map("file_name")
  filePath         String     @map("file_path")
  fileSize         Int        @map("file_size")
  extractedNit     String?    @map("extracted_nit")
  extractedDate    DateTime?  @map("extracted_date")
  extractedAmount  Decimal?   @db.Decimal(12, 2) @map("extracted_amount")
  extractedConcept String?    @map("extracted_concept")
  uploadedById     String?    @map("uploaded_by")
  customerId       String?    @map("customer_id")
  createdAt        DateTime   @default(now()) @map("created_at")

  uploadedBy Profile?  @relation("InvoiceUploader", fields: [uploadedById], references: [id])
  customer   Customer? @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("invoice_uploads")
}

model DocumentSequence {
  id    String @id
  value Int    @default(0)

  @@map("document_sequences")
}

model Quote {
  id          String      @id @default(uuid())
  quoteNumber String      @unique @map("quote_number")
  customerId  String      @map("customer_id")
  issueDate   DateTime    @map("issue_date")
  validUntil  DateTime?   @map("valid_until")
  items       Json
  subtotal    Decimal     @default(0) @db.Decimal(12, 2)
  discountTotal Decimal   @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal    Decimal     @default(0) @map("tax_total") @db.Decimal(12, 2)
  total       Decimal     @default(0) @db.Decimal(12, 2)
  status      QuoteStatus @default(PENDIENTE)
  notes       String?
  createdById String?     @map("created_by")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy Profile? @relation("QuoteCreator", fields: [createdById], references: [id])
  purchaseOrders PurchaseOrder[]

  @@index([customerId])
  @@index([status])
  @@index([issueDate])
  @@map("quotes")
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  poNumber    String              @unique @map("po_number")
  customerId  String              @map("customer_id")
  issueDate   DateTime            @map("issue_date")
  expectedDate DateTime?          @map("expected_date")
  items       Json
  subtotal    Decimal             @default(0) @db.Decimal(12, 2)
  discountTotal Decimal           @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal    Decimal             @default(0) @map("tax_total") @db.Decimal(12, 2)
  total       Decimal             @default(0) @db.Decimal(12, 2)
  status      PurchaseOrderStatus @default(SOLICITADA)
  invoiceId   String?             @map("invoice_id")
  quoteId     String?             @map("quote_id")
  notes       String?
  createdById String?             @map("created_by")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  customer  Customer @relation(fields: [customerId], references: [id])
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  quote     Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  createdBy Profile? @relation("PurchaseOrderCreator", fields: [createdById], references: [id])
  deliveryOrders DeliveryOrder[]

  @@index([customerId])
  @@index([status])
  @@index([issueDate])
  @@map("purchase_orders")
}

model DeliveryOrder {
  id          String              @id @default(uuid())
  doNumber    String              @unique @map("do_number")
  customerId  String              @map("customer_id")
  invoiceId   String?             @map("invoice_id")
  purchaseOrderId String?         @map("purchase_order_id")
  scheduledAt DateTime?           @map("scheduled_at")
  deliveredAt DateTime?           @map("delivered_at")
  items       Json
  status      DeliveryOrderStatus @default(PENDIENTE)
  notes       String?
  createdById String?             @map("created_by")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  customer  Customer        @relation(fields: [customerId], references: [id])
  invoice   Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  createdBy Profile?        @relation("DeliveryOrderCreator", fields: [createdById], references: [id])

  @@index([customerId])
  @@index([status])
  @@map("delivery_orders")
}

model Resolution {
  id               String         @id @default(uuid())
  prefix           String
  resolutionNumber String         @map("resolution_number")
  from             Int
  to               Int
  next             Int
  dateFrom         DateTime?      @map("date_from")
  dateTo           DateTime?      @map("date_to")
  type             ResolutionType @default(FACTURA)
  isActive         Boolean        @default(true) @map("is_active")
  ambient          Ambient        @default(PRODUCCION)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  invoices Invoice[]

  @@index([type])
  @@map("resolutions")
}

model ReceivedDocument {
  id            String   @id @default(uuid())
  customerId    String?  @map("customer_id")
  supplierName  String   @map("supplier_name")
  supplierNit   String?  @map("supplier_nit")
  documentNumber String  @map("document_number")
  issueDate     DateTime @map("issue_date")
  amount        Decimal  @db.Decimal(12, 2)
  taxAmount     Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  concept       String?
  filePath      String?  @map("file_path")
  notes         String?
  createdById   String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy Profile?  @relation("ReceivedDocumentCreator", fields: [createdById], references: [id])

  @@index([customerId])
  @@index([issueDate])
  @@map("received_documents")
}

enum PublicInquiryStatus {
  NUEVA
  CONTACTADA
  CERRADA
}

model PublicInquiry {
  id        String              @id @default(uuid())
  name      String
  phone     String
  email     String?
  company   String?  @map("company")
  service   String?
  message   String?
  source    String?  @default("web")
  status    PublicInquiryStatus @default(NUEVA)
  handledById String? @map("handled_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  handledBy Profile? @relation("PublicInquiryHandler", fields: [handledById], references: [id])

  @@index([status])
  @@index([createdAt])
  @@map("public_inquiries")
}

model DocumentAttachment {
  id           String   @id @default(uuid())
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  fileName     String   @map("file_name")
  filePath     String   @map("file_path")
  fileSize     Int?     @map("file_size")
  mimeType     String?  @map("mime_type")
  notes        String?
  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  uploadedBy Profile @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  @@index([entityType, entityId])
  @@map("document_attachments")
}
